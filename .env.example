# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local preview only. Set BOTH false in production.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key encoded as base64. Generate: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Gmail OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# -----------------------------------------------------------------------------
# Mail transport safety
# -----------------------------------------------------------------------------
# Keep false. Only enable for a trusted private/self-signed mail server you own.
ALLOW_INSECURE_MAIL_TLS=false
ALLOW_PRIVATE_MAIL_HOSTS=false

# -----------------------------------------------------------------------------
# Background jobs
# -----------------------------------------------------------------------------
# Generate a long random value, e.g. openssl rand -hex 32
CRON_SECRET=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_replace_me

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Cost-sensitive current GPT-5.6 model; change without editing app code if needed.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000

# Random 32+ byte secret used to sign tracking links and hash client IPs
TRACKING_SECRET=

# Optional Google Postmaster Tools OAuth callback
GOOGLE_POSTMASTER_REDIRECT_URI=http://localhost:3000/api/deliverability/google/callback
